<Window x:Class="OpenRag.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Open RAG" Icon="Assets/OpenRag.ico" Width="1320" Height="820" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="#EAF2FF">
    <!-- No Windows title bar: the page draws its own, in the Arena style, as a WebView2 drag region.
         WindowChrome keeps resizing from the thin border around the page, and the window's shadow. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border x:Name="Frame" Padding="4">
        <!-- The whole interface is the React app in desktop/web; this window only hosts it and the engine. -->
        <wv2:WebView2 x:Name="Web" />
    </Border>
</Window>
